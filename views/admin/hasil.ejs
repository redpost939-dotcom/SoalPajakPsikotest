<%- include('../partials/header', { title: 'Hasil Tes' }) %>
<div class="crumbs"><a href="/">Beranda</a> &raquo; <a href="/admin">Admin</a> &raquo; Hasil Tes</div>
<%- include('_nav') %>

<section class="section">
  <div class="section-head">
    <h1>Semua Hasil Tes</h1>
  </div>
  <form method="get" action="/admin/hasil" class="filter-bar">
    <label>Filter jenis:</label>
    <select name="tipe" onchange="this.form.submit()">
      <option value="">Semua</option>
      <option value="psikotest" <%= filter === 'psikotest' ? 'selected' : '' %>>Psikotest</option>
      <option value="belajar" <%= filter === 'belajar' ? 'selected' : '' %>>Modul</option>
    </select>
  </form>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>ID</th><th>User</th><th>Jenis</th><th>Kategori</th><th>Level</th><th>Benar</th><th>Total</th><th>Skor</th><th>Tanggal</th></tr></thead>
      <tbody>
        <% daftar.forEach(h => { %>
          <tr>
            <td><%= h.id %></td>
            <td><%= h.username || 'tanpa akun' %></td>
            <td><%= h.tipe %></td>
            <td><%= h.kategori %></td>
            <td><%= h.level %></td>
            <td><%= h.benar %></td>
            <td><%= h.total_soal %></td>
            <td><b><%= h.skor %>%</b></td>
            <td class="muted"><%= h.dibuat.toLocaleString('id-ID') %></td>
          </tr>
        <% }) %>
        <% if (daftar.length === 0) { %><tr><td colspan="9" class="muted">Belum ada hasil tes.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../partials/footer') %>