<%- include('../partials/header', { title: 'Materi' }) %>
<div class="crumbs"><a href="/">Beranda</a> &raquo; <a href="/admin">Admin</a> &raquo; Materi</div>
<%- include('_nav') %>

<section class="section">
  <div class="section-head">
    <h1>Kelola Materi</h1>
    <a class="btn" href="/admin/materi/baru">+ Materi Baru</a>
  </div>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Kategori</th><th>Urutan</th><th>Judul</th><th>Aksi</th></tr></thead>
      <tbody>
        <% daftar.forEach(m => { %>
          <tr>
            <td><%= m.kategori_nama %></td>
            <td><%= m.urutan %></td>
            <td class="maxw"><%= m.judul %></td>
            <td class="actions">
              <a class="btn btn-sm btn-outline" href="/admin/materi/<%= m.id %>/edit">Edit</a>
              <form method="post" action="/admin/materi/<%= m.id %>/hapus" onsubmit="return confirm('Hapus materi ini?')">
                <button class="btn btn-sm btn-danger" type="submit">Hapus</button>
              </form>
            </td>
          </tr>
        <% }) %>
        <% if (daftar.length === 0) { %><tr><td colspan="4" class="muted">Tidak ada materi.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../partials/footer') %>