<%- include('../partials/header', { title: 'Soal' }) %>
<div class="crumbs"><a href="/">Beranda</a> &raquo; <a href="/admin">Admin</a> &raquo; Soal</div>
<%- include('_nav') %>

<section class="section">
  <div class="section-head">
    <h1>Kelola Soal</h1>
    <a class="btn" href="/admin/soal/baru">+ Soal Baru</a>
  </div>
  <form method="get" action="/admin/soal" class="filter-bar">
    <label>Filter kategori:</label>
    <select name="kategori" onchange="this.form.submit()">
      <option value="">Semua</option>
      <% kategoris.forEach(k => { %>
        <option value="<%= k.kode %>" <%= filter === k.kode ? 'selected' : '' %>><%= k.tipe %> - <%= k.nama %></option>
      <% }) %>
    </select>
  </form>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>ID</th><th>Kategori</th><th>Level</th><th>Pertanyaan</th><th>Kunci</th><th>Aksi</th></tr></thead>
      <tbody>
        <% daftar.forEach(s => { %>
          <tr>
            <td><%= s.id %></td>
            <td><%= s.kategori_nama %></td>
            <td><%= s.level %></td>
            <td class="maxw"><%= s.pertanyaan %></td>
            <td><%= 'ABCDE'[s.kunci - 1] || s.kunci %></td>
            <td class="actions">
              <a class="btn btn-sm btn-outline" href="/admin/soal/<%= s.id %>/edit">Edit</a>
              <form method="post" action="/admin/soal/<%= s.id %>/hapus" onsubmit="return confirm('Hapus soal ini?')">
                <button class="btn btn-sm btn-danger" type="submit">Hapus</button>
              </form>
            </td>
          </tr>
        <% }) %>
        <% if (daftar.length === 0) { %><tr><td colspan="6" class="muted">Tidak ada soal.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../partials/footer') %>