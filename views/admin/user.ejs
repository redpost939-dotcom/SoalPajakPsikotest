<%- include('../partials/header', { title: 'Pengguna' }) %>
<div class="crumbs"><a href="/">Beranda</a> &raquo; <a href="/admin">Admin</a> &raquo; Pengguna</div>
<%- include('_nav') %>

<section class="section">
  <h1>Kelola Pengguna</h1>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>ID</th><th>Username</th><th>Nama</th><th>Role</th><th>Jml Tes</th><th>Dibuat</th><th>Aksi</th></tr></thead>
      <tbody>
        <% daftar.forEach(u => { %>
          <tr>
            <td><%= u.id %></td>
            <td><%= u.username %></td>
            <td><%= u.nama %></td>
            <td>
              <form method="post" action="/admin/user/<%= u.id %>/role">
                <select name="role" onchange="this.form.submit()">
                  <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>user (Peserta penuh)</option>
                  <option value="psikotest" <%= u.role === 'psikotest' ? 'selected' : '' %>>psikotest (hanya psikotest)</option>
                  <option value="akuntansi" <%= u.role === 'akuntansi' ? 'selected' : '' %>>akuntansi (hanya akuntansi/pajak)</option>
                  <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>admin (semua + panel)</option>
                </select>
              </form>
            </td>
            <td><%= u.jml_tes %></td>
            <td class="muted"><%= u.dibuat ? u.dibuat.toLocaleString('id-ID') : '' %></td>
            <td class="actions">
              <form method="post" action="/admin/user/<%= u.id %>/reset">
                <input type="text" name="password" placeholder="pw baru" size="8">
                <button class="btn btn-sm btn-outline" type="submit">Reset PW</button>
              </form>
              <form method="post" action="/admin/user/<%= u.id %>/hapus" onsubmit="return confirm('Hapus pengguna ini?')">
                <button class="btn btn-sm btn-danger" type="submit">Hapus</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../partials/footer') %>