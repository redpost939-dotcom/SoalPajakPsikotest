<%- include('../partials/header', { title: 'Form Kategori' }) %>
<div class="crumbs"><a href="/">Beranda</a> &raquo; <a href="/admin">Admin</a> &raquo; <a href="/admin/kategori">Kategori</a> &raquo; <%= kategori ? 'Edit' : 'Baru' %></div>
<%- include('_nav') %>

<section class="section form-card">
  <h1><%= kategori ? 'Edit Kategori' : 'Kategori Baru' %></h1>
  <% if (pesan) { %><div class="alert alert-error"><%= pesan %></div><% } %>
  <form method="post" action="/admin/kategori/simpan">
    <% if (kategori) { %><input type="hidden" name="id" value="<%= kategori.id %>"><% } %>
    <div class="form-row">
      <div class="form-group">
        <label>Tipe *</label>
        <select name="tipe">
          <option value="psikotest" <%= kategori && kategori.tipe === 'psikotest' ? 'selected' : '' %>>Psikotest</option>
          <option value="akuntansi" <%= kategori && kategori.tipe === 'akuntansi' ? 'selected' : '' %>>Akuntansi</option>
          <option value="pajak" <%= kategori && kategori.tipe === 'pajak' ? 'selected' : '' %>>Pajak</option>
        </select>
      </div>
      <div class="form-group">
        <label>Kode (unik) *</label>
        <input type="text" name="kode" value="<%= kategori ? kategori.kode : '' %>" required>
      </div>
      <div class="form-group">
        <label>Urutan *</label>
        <input type="number" name="urutan" value="<%= kategori ? kategori.urutan : '' %>" required>
      </div>
    </div>
    <div class="form-group">
      <label>Nama *</label>
      <input type="text" name="nama" value="<%= kategori ? kategori.nama : '' %>" required>
    </div>
    <div class="form-group">
      <label>Deskripsi</label>
      <textarea name="deskripsi" rows="3"><%= kategori ? kategori.deskripsi : '' %></textarea>
    </div>
    <button class="btn btn-primary" type="submit">Simpan</button>
    <a class="btn btn-outline" href="/admin/kategori">Batal</a>
  </form>
</section>
<%- include('../partials/footer') %>