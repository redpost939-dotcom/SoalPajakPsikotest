<%- include('../partials/header', { title: 'Admin' }) %>
<div class="crumbs"><a href="/">Beranda</a> &raquo; Panel Admin</div>
<%- include('_nav') %>

<section class="section">
  <h1>Dashboard</h1>
  <div class="stat-grid">
    <div class="stat"><b><%= stats.kategori %></b><span>Kategori</span></div>
    <div class="stat"><b><%= stats.soal %></b><span>Soal</span></div>
    <div class="stat"><b><%= stats.materi %></b><span>Materi</span></div>
    <div class="stat"><b><%= stats.user %></b><span>Pengguna</span></div>
    <div class="stat"><b><%= stats.hasil %></b><span>Hasil Tes</span></div>
  </div>
</section>

<section class="section">
  <h2>Hasil Tes Terbaru</h2>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>ID</th><th>User</th><th>Jenis</th><th>Kategori</th><th>Skor</th><th>Tanggal</th></tr></thead>
      <tbody>
        <% recent.forEach(h => { %>
          <tr>
            <td><%= h.id %></td>
            <td><%= h.username || 'tanpa akun' %></td>
            <td><%= h.tipe %></td>
            <td><%= h.kategori %></td>
            <td><b><%= h.skor %>%</b></td>
            <td class="muted"><%= h.dibuat.toLocaleString('id-ID') %></td>
          </tr>
        <% }) %>
        <% if (recent.length === 0) { %><tr><td colspan="6" class="muted">Belum ada hasil tes.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../partials/footer') %>