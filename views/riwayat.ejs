<%- include('partials/header', { title: 'Riwayat Saya' }) %>
<div class="crumbs"><a href="/">Beranda</a> &raquo; Riwayat Saya</div>
<section class="section">
  <div class="section-head"><h1>Riwayat Tes Saya</h1></div>
  <% if (daftar.length === 0) { %>
    <p class="muted">Belum ada tes yang dikerjakan. Mulai dari <a href="/psikotest">Psikotest</a> atau <a href="/belajar">Akuntansi &amp; Pajak</a>.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>No</th><th>Jenis</th><th>Kategori</th><th>Level</th><th>Benar</th><th>Total</th><th>Skor</th><th>Tanggal</th></tr></thead>
        <tbody>
          <% daftar.forEach((h, i) => { %>
            <tr>
              <td><%= i+1 %></td>
              <td><span class="badge <%= h.tipe === 'psikotest' ? 'ok' : '' %>"><%= h.tipe === 'psikotest' ? 'PSIKOTEST' : 'MODUL' %></span></td>
              <td><%= h.kategori %></td>
              <td><%= h.level %></td>
              <td><%= h.benar %></td>
              <td><%= h.total_soal %></td>
              <td><b><%= h.skor %>%</b></td>
              <td class="muted"><%= h.dibuat.toLocaleString('id-ID') %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<%- include('partials/footer') %>