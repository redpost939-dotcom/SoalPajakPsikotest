<%- include('../partials/header', { title: 'Masuk' }) %>
<div class="auth-wrap">
  <div class="auth-card">
    <h1>Masuk</h1>
    <% if (pesan) { %><div class="alert alert-error"><%= pesan %></div><% } %>
    <form method="post" action="/auth/login?lanjut=<%= encodeURIComponent(lanjut) %>">
      <div class="form-group">
        <label>Username</label>
        <input type="text" name="username" required autofocus>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" required>
      </div>
      <button class="btn btn-primary" type="submit">Masuk</button>
    </form>
    <p class="muted mt">Belum punya akun? <a href="/auth/register">Daftar di sini</a></p>
  </div>
</div>
<%- include('../partials/footer') %>