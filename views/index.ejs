<%- include('partials/header', { title: 'Beranda' }) %>
<section class="hero">
  <h1>Latihan Psikotest &amp; Belajar Pajak</h1>
  <p>Satu tempat untuk berlatih soal psikotest (gaya tes rekrutmen di Indonesia), mempelajari akuntansi dasar, pajak dasar, serta Brevet A dan B — lengkap dengan kunci jawaban dan pembahasan.</p>
  <% if (totalSoal > 0) { %>
  <div class="hero-stats">
    <div class="hero-stat"><b><%= totalSoal %></b><span>Soal</span></div>
    <div class="hero-stat"><b><%= totalMateri %></b><span>Materi</span></div>
    <div class="hero-stat"><b><%= totalKategori %></b><span>Modul</span></div>
  </div>
  <% } %>
</section>

<% if (psikotest.length > 0) { %>
<section class="section">
  <div class="section-head">
    <h2>Menu Psikotest</h2>
    <a class="btn btn-outline" href="/psikotest">Lihat semua &rarr;</a>
  </div>
  <p class="muted">Urutan seperti tes asli: Verbal &rarr; Numerik &rarr; Logika &rarr; Spasial &rarr; Matematika &rarr; Kepribadian. Setiap kategori berlevel Mudah &rarr; Sedang &rarr; Sulit.</p>
  <div class="dash-grid">
    <% psikotest.forEach(k => { %>
      <a class="tile" href="/psikotest/<%= k.kode %>" style="--c1:<%= k.c1 %>;--c2:<%= k.c2 %>;">
        <span class="tile-ico"><%= k.i %></span>
        <span class="tile-body">
          <h3><%= k.nama %></h3>
          <p><%= k.deskripsi %></p>
          <span class="badge tile-badge"><%= k.jml_soal %> soal</span>
        </span>
      </a>
    <% }) %>
  </div>
</section>
<% } %>

<% if (belajar.length > 0) { %>
<section class="section">
  <div class="section-head">
    <h2>Menu Akuntansi &amp; Pajak</h2>
    <a class="btn btn-outline" href="/belajar">Lihat semua &rarr;</a>
  </div>
  <p class="muted">Materi lalu soal latihan per bab: Akuntansi Dasar, Pajak Dasar (Brevet A), Brevet B, dan PBB &amp; BPHTB.</p>
  <div class="dash-grid">
    <% belajar.forEach(b => { %>
      <a class="tile" href="/belajar/<%= b.kode %>" style="--c1:<%= b.c1 %>;--c2:<%= b.c2 %>;">
        <span class="tile-ico"><%= b.i %></span>
        <span class="tile-body">
          <h3><%= b.nama %></h3>
          <p><%= b.deskripsi %></p>
          <span class="badge tile-badge"><%= b.jml_materi %> materi &middot; <%= b.jml_soal %> soal</span>
        </span>
      </a>
    <% }) %>
  </div>
</section>
<% } %>

<% if (psikotest.length === 0 && belajar.length === 0) { %>
<section class="section">
  <p class="muted">Silakan <a href="/auth/login">masuk</a> dengan akun Anda. Menu yang tersedia sesuai hak akses akun Anda.</p>
</section>
<% } %>

<%- include('partials/footer') %>