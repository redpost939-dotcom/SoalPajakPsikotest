<%- include('../partials/header', { title: 'Soal ' + nomor + ' dari ' + total }) %>
<div class="crumbs">
  <a href="/">Beranda</a> &raquo;
  <% if (kuis.tipe === 'psikotest') { %><a href="/psikotest">Psikotest</a><% } else { %><a href="/belajar">Akuntansi &amp; Pajak</a><% } %>
  &raquo; <%= kuis.kategori %>
</div>

<div class="progress"><div class="progress-bar" style="width:<%= (nomor/total)*100 %>%"></div></div>

<section class="quiz-box">
  <div class="quiz-meta">
    <span class="badge"><%= kuis.tipe === 'psikotest' ? 'PSIKOTEST' : 'MODUL' %></span>
    <% if (kuis.level !== 'semua') { %><span class="badge"><%= kuis.level.charAt(0).toUpperCase() + kuis.level.slice(1) %></span><% } %>
    <span class="muted">Soal <%= nomor %> dari <%= total %></span>
  </div>

  <h2 class="question-text">Soal <%= nomor %></h2>
  <p class="question-body"><%= soal.pertanyaan %></p>

  <% if (soal.diagram) { %>
    <pre class="diagram"><%= soal.diagram %></pre>
  <% } %>

  <form method="post" action="<%= alur %>/<%= nomor %>">
    <div class="options">
      <% soal.opsi.forEach((op, i) => { %>
        <label class="option">
          <input type="radio" name="jawaban" value="<%= i+1 %>" required>
          <span><b><%= 'ABCDE'[i] %>.</b> <%= op %></span>
        </label>
      <% }) %>
    </div>
    <div class="quiz-nav">
      <% if (nomor > 1) { %>
        <a class="btn btn-outline" href="<%= alur %>/<%= nomor-1 %>">&larr; Sebelumnya</a>
      <% } %>
      <button class="btn btn-primary" type="submit">
        <% if (nomor === total) { %>Selesai &amp; Lihat Hasil<% } else { %>Simpan &amp; Lanjut &rarr;<% } %>
      </button>
    </div>
  </form>
</section>
<%- include('../partials/footer') %>