<%- include('../partials/header', { title: kategori.nama }) %>
<div class="crumbs"><a href="/">Beranda</a> &raquo; <a href="/psikotest">Psikotest</a> &raquo; <%= kategori.nama %></div>
<section class="section">
  <div class="section-head">
    <h1><%= kategori.nama %></h1>
  </div>
  <p><%= kategori.deskripsi %></p>

  <h3 class="mt">Pilih Level dan Mulai</h3>
  <div class="grid small">
    <form method="post" action="/psikotest/<%= kategori.kode %>/mulai" class="card">
      <input type="hidden" name="level" value="semua">
      <h3>Semua (Bertahap)</h3>
      <p class="muted">Mudah &rarr; Sedang &rarr; Sulit dalam satu sesi.</p>
      <button class="btn" type="submit">Mulai &rarr;</button>
    </form>
    <% level.forEach(l => { %>
      <form method="post" action="/psikotest/<%= kategori.kode %>/mulai" class="card">
        <input type="hidden" name="level" value="<%= l.level %>">
        <h3><%= l.level.charAt(0).toUpperCase() + l.level.slice(1) %></h3>
        <p class="muted"><%= l.jml %> soal</p>
        <button class="btn" type="submit">Mulai &rarr;</button>
      </form>
    <% }) %>
  </div>
</section>
<%- include('../partials/footer') %>