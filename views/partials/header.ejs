<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' ? title : 'Bank Soal Psikotest & Pajak' %></title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="topbar">
  <div class="wrap topbar-in">
    <a class="brand" href="/">BankSoal <span>Psikotest &amp; Pajak</span></a>
    <nav>
      <% if (typeof can === 'function' && can('psikotest')) { %><a href="/psikotest">Psikotest</a><% } %>
      <% if (typeof can === 'function' && can('belajar')) { %><a href="/belajar">Akuntansi &amp; Pajak</a><% } %>
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/riwayat">Riwayat</a>
        <% if (can('admin')) { %><a href="/admin" class="nav-admin">Admin</a><% } %>
        <span class="nav-user"><%= user.nama %> (<%= user.username %>)</span>
        <a href="/auth/logout">Keluar</a>
      <% } else { %>
        <a href="/auth/login">Masuk</a>
        <a href="/auth/register">Daftar</a>
      <% } %>
    </nav>
  </div>
</header>
<main class="wrap">